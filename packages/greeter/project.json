{
  "name": "greeter",
  "sourceRoot": "packages/greeter/src",
  "projectType": "library",
  "implicitDependencies": ["hello"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/packages/greeter",
        "main": "packages/greeter/src/index.ts",
        "tsConfig": "packages/greeter/tsconfig.lib.json",
        "assets": []
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/greeter/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/greeter/src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --conditions=@dev-ledger/source --experimental-strip-types --test packages/greeter/src/index.test.ts"
      }
    }
  }
}
