  "author": {
    "name": "Shady Alzayat",
    "url": "https://github.com/salzayat"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salzayat/dev-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/salzayat/dev-ledger/issues"
  },
  "homepage": "https://github.com/salzayat/dev-ledger#readme",
  "keywords": [
    "agents",
    "monorepo",
    "nx",
    "openspec",
    "typescript",
    "developer-tools"
  ],
  "type": "module",
  "scripts": {
    "ledger": "./scripts/ledger.sh",
