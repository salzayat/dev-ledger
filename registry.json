{
  "schemaVersion": 1,
  "repositories": [
    {
      "name": "dev-ledger",
      "url": "git@github.com:salzayat/dev-ledger.git",
      "defaultBranch": "main",
      "releaseTagPattern": "v*",
      "thresholds": {
        "waitTimeP50Seconds": 172800,
        "reworkWindowDays": 14
      },
      "rework": {
        "ignore": [
          "plans/roadmap.md",
          "README.md",
          "docs/**",
          "openspec/**",
          "package-lock.json",
          ".telemetry/**"
        ]
      }
    }
  ]
}
