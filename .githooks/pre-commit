#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

current_branch=$(git branch --show-current)
if [ "$current_branch" = "main" ]; then
  printf '%s\n' "Refusing to commit directly to main." >&2
  printf '%s\n' "Create a feature branch first: git switch -c <branch>" >&2
  exit 1
fi

# Session files must satisfy the schema before they are committed with the work.
staged_sessions=$(git diff --cached --name-only --diff-filter=ACMR -- .telemetry/sessions | grep '\.json$' || true)
if [ -n "$staged_sessions" ] && [ -d node_modules ]; then
  # shellcheck disable=SC2086
  ./scripts/telemetry.sh validate $staged_sessions
fi

./scripts/check.sh
