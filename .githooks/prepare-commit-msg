#!/bin/sh
# Writes the Spec:, Session:, Change:, effort, and Cost-Class: trailers onto every commit made through the
# hooks, from values kept in branch-local git configuration. Skipped for merge and squash messages, which
# carry the platform's own message. Skipping this hook surfaces later as an undeclared session.
set -eu

message_file=$1
source=${2:-}

case "$source" in
  merge | squash) exit 0 ;;
esac

branch=$(git branch --show-current 2>/dev/null || true)
[ -n "$branch" ] || exit 0

config() {
  git config --get "branch.$branch.$1" 2>/dev/null || true
}

spec=$(config telemetry-spec)
change=$(config telemetry-change)
story_points=$(config telemetry-story-points)
work_hours=$(config telemetry-work-hours)
cost_class=$(config telemetry-cost-class)
# A session identifier when one is active, and `none` only when an operator declared this branch human-only.
# There is deliberately no fallback: an unset variable means the repository does not know who did the work,
# and writing `none` there would turn that ignorance into a claim that a human worked alone. Writing no
# trailer leaves the change `undeclared`, which is a gap the projection already counts.
session=$(git config --get telemetry.session 2>/dev/null || true)
if [ -z "$session" ] && [ "$(config telemetry-human-only)" = "true" ]; then
  session=none
fi

if [ -z "$change" ]; then
  change="c-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
  git config "branch.$branch.telemetry-change" "$change"
fi

set -- --trailer "Change: $change"
[ -n "$session" ] && set -- --trailer "Session: $session" "$@"
[ -n "$spec" ] && set -- --trailer "Spec: $spec" "$@"
[ -n "$story_points" ] && set -- "$@" --trailer "Story-Points: $story_points"
[ -n "$work_hours" ] && set -- "$@" --trailer "Work-Hours: $work_hours"
[ -n "$cost_class" ] && set -- "$@" --trailer "Cost-Class: $cost_class"

git interpret-trailers --in-place --if-exists doNothing "$@" "$message_file"
